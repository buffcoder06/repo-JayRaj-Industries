@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Invoice Generation";
    ViewData["Section"] = "Reporting";
}

@section Styles {
    <link rel="stylesheet" href="~/css/jr-invoice.css" asp-append-version="true" />
}

<div class="jr-page-title">
    <div>
        <h1>Invoice Generation</h1>
        <div class="jr-page-title__meta">What you see on the right is exactly what downloads.</div>
    </div>
</div>

<section class="jr-invoice-layout">
    <div class="jr-invoice-rail" id="jrInvoiceRail">
        <div class="jr-card">
            <div class="jr-card__header"><span class="jr-card__title">Invoice setup</span></div>
            <div class="jr-card__body jr-stack">
                <div class="jr-field">
                    <label class="jr-field__label">Invoice type</label>
                    <div class="jr-dropdown jr-full" data-jr-dropdown>
                        <select id="invoiceProfileSelect" hidden>
                            <option value="kundalik_automation">KUNDLIK AUTOMATION PVT. LTD</option>
                            <option value="kundalik_engineers">KUNDLIK ENGINEERS</option>
                            <option value="scrap">SCRAP INVOICE</option>
                        </select>
                        <button type="button" class="jr-dropdown__trigger"><span class="jr-dropdown__label"></span><svg class="jr-dropdown__caret" viewBox="0 0 24 24"><path d="M7 10l5 5 5-5z" /></svg></button>
                        <div class="jr-dropdown__panel" hidden>
                            <div class="jr-dropdown__filter">
                                <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 5L20.49 19zm-6 0a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9z" /></svg>
                                <input class="jr-dropdown__filter-input" type="text" placeholder="Filter…" />
                            </div>
                            <div class="jr-dropdown__list"></div>
                            <div class="jr-dropdown__footer"><span>↑↓ to move · Enter to select</span><span>Esc to close</span></div>
                        </div>
                    </div>
                </div>

                <div class="jr-field">
                    <label class="jr-field__label">Billing period</label>
                    <div class="jr-daterange jr-full" data-jr-daterange>
                        <input type="hidden" id="invFromDate" data-jr-role="start" />
                        <input type="hidden" id="invToDate" data-jr-role="end" />
                        <button type="button" class="jr-daterange__trigger">
                            <svg viewBox="0 0 24 24"><path d="M7 2v2H5a2 2 0 0 0-2 2v2h18V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2z" /><path d="M21 10H3v8a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2z" /></svg>
                            <span class="jr-daterange__label jr-tabular"></span>
                        </button>
                        <div class="jr-daterange__panel" hidden></div>
                    </div>
                </div>
                <div class="jr-chip-row">
                    <button type="button" class="jr-daterange__chip" id="btnPeriodThisMonth">This month</button>
                    <button type="button" class="jr-daterange__chip" id="btnPeriodLastMonth">Last month</button>
                    <button type="button" class="jr-daterange__chip" id="btnPeriodQuarter">Quarter</button>
                </div>

                <div class="jr-grid-2">
                    <div class="jr-field">
                        <label class="jr-field__label" for="invNo">Invoice no</label>
                        <input type="text" id="invNo" class="jr-input jr-tabular" placeholder="26-27 / 91" />
                    </div>
                    <div class="jr-field">
                        <label class="jr-field__label">Invoice date</label>
                        <div class="jr-daterange jr-full" data-jr-daterange>
                            <input type="hidden" id="invDate" data-jr-role="start" />
                            <button type="button" class="jr-daterange__trigger">
                                <svg viewBox="0 0 24 24"><path d="M7 2v2H5a2 2 0 0 0-2 2v2h18V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2z" /><path d="M21 10H3v8a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2z" /></svg>
                                <span class="jr-daterange__label jr-tabular"></span>
                            </button>
                            <div class="jr-daterange__panel" hidden></div>
                        </div>
                    </div>
                    <div class="jr-field">
                        <label class="jr-field__label" for="poNo">PO no</label>
                        <input type="text" id="poNo" class="jr-input jr-tabular" value="JW/252600012" />
                    </div>
                    <div class="jr-field">
                        <label class="jr-field__label">PO date</label>
                        <div class="jr-daterange jr-full" data-jr-daterange>
                            <input type="hidden" id="poDate" data-jr-role="start" />
                            <button type="button" class="jr-daterange__trigger">
                                <svg viewBox="0 0 24 24"><path d="M7 2v2H5a2 2 0 0 0-2 2v2h18V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2z" /><path d="M21 10H3v8a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2z" /></svg>
                                <span class="jr-daterange__label jr-tabular"></span>
                            </button>
                            <div class="jr-daterange__panel" hidden></div>
                        </div>
                    </div>
                </div>

                @* Party details are owned by InvoiceGeneration.js (set per invoice
                   type) and shown on the sheet itself; these just carry them. *@
                <input type="hidden" id="billTo" value="KUNDLIK AUTOMATION PVT. LTD" />
                <input type="hidden" id="billAddress" value="GAT NO.624/9, Kuruli Village, Alandi Phata, Chakan, Tal. Khed, Dist. Pune - 410501" />
                <input type="hidden" id="partyGst" value="27AACCK6309H1ZK" />
                <input type="hidden" id="partyPan" value="AACCC6309H" />
            </div>
        </div>

        <div class="jr-card" id="scrapManualSection" style="display:none;">
            <div class="jr-card__header"><span class="jr-card__title">Scrap details</span></div>
            <div class="jr-card__body jr-stack">
                <div class="jr-field">
                    <label class="jr-field__label">Scrap party</label>
                    <div class="jr-dropdown jr-full" data-jr-dropdown>
                        <select id="scrapPartySelect" hidden>
                            <option value="kundalik_automation">KUNDLIK AUTOMATION PVT. LTD</option>
                            <option value="kundalik_engineers">KUNDLIK ENGINEERS</option>
                            <option value="steel_trade">STEEL TRADE</option>
                        </select>
                        <button type="button" class="jr-dropdown__trigger"><span class="jr-dropdown__label"></span><svg class="jr-dropdown__caret" viewBox="0 0 24 24"><path d="M7 10l5 5 5-5z" /></svg></button>
                        <div class="jr-dropdown__panel" hidden>
                            <div class="jr-dropdown__filter">
                                <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 5L20.49 19zm-6 0a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9z" /></svg>
                                <input class="jr-dropdown__filter-input" type="text" placeholder="Filter…" />
                            </div>
                            <div class="jr-dropdown__list"></div>
                            <div class="jr-dropdown__footer"><span>↑↓ to move · Enter to select</span><span>Esc to close</span></div>
                        </div>
                    </div>
                </div>
                <div class="jr-field">
                    <label class="jr-field__label" for="scrapDescription">Scrap description</label>
                    <input type="text" id="scrapDescription" class="jr-input" value="Casting Scrap" />
                </div>
                <div class="jr-grid-2">
                    <div class="jr-field">
                        <label class="jr-field__label" for="scrapQty">Quantity (Kg)</label>
                        <input type="number" id="scrapQty" class="jr-input jr-tabular" min="0" step="0.01" value="0" />
                    </div>
                    <div class="jr-field">
                        <label class="jr-field__label" for="scrapRatePerKg">Rate per Kg</label>
                        <input type="number" id="scrapRatePerKg" class="jr-input jr-tabular" min="0" step="0.01" value="0" />
                    </div>
                </div>
                <div class="jr-field" id="scrapVehicleSection" style="display:none;">
                    <label class="jr-field__label" for="scrapVehicleNo">Vehicle number</label>
                    <input type="text" id="scrapVehicleNo" class="jr-input" placeholder="e.g. MH14AB1234" />
                </div>
            </div>
        </div>

        <div class="jr-card">
            <div class="jr-card__header">
                <span class="jr-card__title">Line items &amp; totals</span>
                <span class="jr-card__subtitle" id="lineItemsSummary"></span>
            </div>
            <div class="jr-card__body jr-stack">
                <div class="jr-stack jr-stack--tight">
                    <button type="button" class="jr-btn jr-btn--ghost jr-btn--block" id="btnLoadInvoiceData">Load Items</button>
                    <div class="jr-row">
                        <button type="button" class="jr-btn jr-btn--text jr-btn--block" id="btnAddInvoiceLine">+ Add line</button>
                        <button type="button" class="jr-btn jr-btn--text jr-btn--block" id="btnRemoveInvoiceLine" disabled>Remove last</button>
                    </div>
                </div>

                <div class="jr-alert jr-alert--warning" id="zeroRateWarning" hidden>
                    <span id="zeroRateWarningText"></span>
                </div>

                <div class="jr-totals">
                    <div class="jr-totals__row"><span>Assessable value</span><strong class="jr-tabular" id="railAssessableValue">0</strong></div>
                    <div class="jr-totals__row"><span>CGST 9%</span><strong class="jr-tabular" id="railCgstValue">0</strong></div>
                    <div class="jr-totals__row"><span>SGST 9%</span><strong class="jr-tabular" id="railSgstValue">0</strong></div>
                    <div class="jr-totals__grand"><span>Invoice total</span><strong class="jr-tabular" id="railGrandTotal">0</strong></div>
                </div>

                <button type="button" class="jr-btn jr-btn--accent jr-btn--block jr-btn--cta" id="btnDownloadInvoicePdf" disabled>Download invoice PDF</button>
                <div class="jr-caption">Every download is written to the invoice audit log</div>
            </div>
        </div>
    </div>

    <div class="jr-invoice-desk">
        <div id="invoiceCanvas" class="invoice-canvas">
            <div class="invoice-head-wrap">
                <div class="invoice-head-logo">
                    <img src="~/images/jr_logo.png" alt="JR logo" />
                </div>
                <div class="invoice-head text-center">
                    <div class="invoice-caption">TAX INVOICE</div>
                    <div class="invoice-company">JAYRAJ INDUSTRIES</div>
                    <div class="invoice-subtext"><span id="pCompanyTopAddress"></span></div>
                    <div class="invoice-subtext"><strong>Office :</strong> B/104, 'Pragati Palace' Sec. No - 29 Plot No - 3 Ravet, Pune 412101.</div>
                    <div class="invoice-subtext"><strong>Contact No. :</strong> 8237362166 / 9856821821 &nbsp;&nbsp; <strong>Email ID :</strong> jayraj.industries.07@gmail.com</div>
                </div>
            </div>

            <div class="row g-0 invoice-meta">
                <div class="col-md-6 invoice-meta-left">
                    <div><strong>Billed To :</strong> <span id="pBillTo" class="fw-bold"></span></div>
                    <div id="pBillAddress"></div>
                    <div><strong>Party GST No :</strong> <span id="pPartyGst"></span></div>
                    <div id="pVehicleNoRow" style="display:none;"><strong>Vehicle No :</strong> <span id="pVehicleNo"></span></div>
                    <div id="pPartyPanRow"><strong>Party PAN No :</strong> <span id="pPartyPan"></span></div>
                </div>
                <div class="col-md-6 invoice-meta-right">
                    <div><strong>Invoice No :</strong> <span id="pInvNo"></span></div>
                    <div><strong>Date :</strong> <span id="pInvDate"></span></div>
                    <div><strong>P.O. No :</strong> <span id="pPoNo"></span></div>
                    <div><strong>Date :</strong> <span id="pPoDate"></span></div>
                    <div><strong>Vendor Code :</strong> <span id="pVendorCode"></span></div>
                    <div><strong>HSN / SAC Code :</strong> <span id="pHsnCode"></span></div>
                    <div><strong>State :</strong> Maharashtra &nbsp;&nbsp; <strong>State Code :</strong> 27</div>
                </div>
            </div>

            <div class="tableHeaderFix invoice-table-wrap">
                <table class="table mb-0" id="invoiceItemsTable">
                    <thead>
                        <tr>
                            <th style="width: 70px;">Sr. No.</th>
                            <th>Item Description</th>
                            <th style="width: 90px;">Qty</th>
                            <th style="width: 80px;">Unit</th>
                            <th style="width: 110px;">Rate/<br />Qty.</th>
                            <th style="width: 120px;">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* Same blank-row shape InvoiceGeneration.js renderRows() produces,
                           so the sheet reads as a full page before items are loaded. *@
                        <tr class="invoice-entry-spacer"><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr>
                        @for (var i = 0; i < 11; i++)
                        {
                            <tr class="invoice-filler-row"><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row g-0 mt-0">
                <div class="col-md-6 invoice-foot-left">
                    <div>Payment Term :</div>
                    <div>Remark :</div>
                    <div class="mt-3">Amount in words : <span id="amtWords">Zero Only</span></div>
                </div>
                <div class="col-md-6 invoice-foot-right">
                    <div><span>Assessable Value :</span> <strong id="assessableValue">0</strong></div>
                    <div><span>Total :</span> <strong id="subTotal">0</strong></div>
                    <div><span>CGST % (9.00) :</span> <strong id="cgstValue">0</strong></div>
                    <div><span>SGST % (9.00) :</span> <strong id="sgstValue">0</strong></div>
                    <div class="grand"><span>Grand Total :</span> <strong id="grandTotal">0</strong></div>
                </div>
            </div>

            <div class="row g-0 invoice-sign">
                <div class="col-md-6 left">
                    <div><strong>GST Tin No: 27BJKPD4175R1ZJ</strong></div>
                    <div class="mt-3">Certified that the particulars given above are true &amp; correct</div>
                    <div class="mt-3">Subject to Pune Jurisdiction.</div>
                </div>
                <div class="col-md-2 center text-center">
                    <div class="receiver-box"></div>
                    <div>Receiver Signature</div>
                </div>
                <div class="col-md-4 right text-center">
                    <div><strong>For JAYRAJ INDUSTRIES</strong></div>
                    <div class="sign-gap">
                        <img src="~/images/abhi_dada-sign-original.png" alt="Authorised Signature" class="authorised-sign-img" />
                    </div>
                    <div><strong>( Abhishek R. Desale )</strong></div>
                    <div>Authorised Signatory</div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
    <script src="~/appjs/InvoiceGeneration.js" asp-append-version="true"></script>
    <script src="~/appjs/InvoiceRailSync.js" asp-append-version="true"></script>
}
