<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JayRaj_Industries</title>
    <link rel="icon" type="image/png" href="~/images/jr_logo.png" />
    <link rel="shortcut icon" type="image/png" href="~/images/jr_logo.png" />
    <link rel="apple-touch-icon" href="~/images/jr_logo.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Spectral:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/jr-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/jr-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/jr-controls.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/jr-components.css" asp-append-version="true" />
    <!-- style.css: fully superseded by the jr-*.css files above (no view
         references any of its classes anymore) and its old dark-sidebar
         overrides were actively fighting the new light shell. Kept on disk,
         no longer loaded. page.css stays: Invoice/Index.cshtml still uses
         its invoice-canvas/print/table-utility classes. -->
    <link rel="stylesheet" href="~/css/page.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="app-body jr-app">
    @Html.AntiForgeryToken()
    <div class="app-shell" data-theme="system">
        <aside class="app-sidebar" aria-label="Primary navigation">
            <div class="app-sidebar__brand">
                <span class="app-sidebar__logo">
                    <img src="~/images/jr_logo.png" alt="JayRaj Industries logo" class="app-sidebar__logo-img" />
                </span>
                <div class="app-sidebar__brand-text">
                    <div class="app-sidebar__title">JayRaj Industries</div>
                    <div class="app-sidebar__subtitle">Chalan Control</div>
                </div>
            </div>

            <nav class="app-sidebar__nav" aria-label="Main">
                <div class="app-sidebar__group">
                    <div class="app-sidebar__group-label">Operations</div>
                    <a class="app-sidebar__link" asp-area="" asp-controller="ChalanProcess" asp-action="Index">
                        <span class="app-sidebar__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <path d="M4 4h7v7H4zM13 4h7v4h-7zM13 10h7v10h-7zM4 13h7v7H4z" />
                            </svg>
                        </span>
                        <span class="app-sidebar__label">Chalan Process</span>
                        <span class="app-sidebar__count" id="sidebarChalanOpenCount" hidden></span>
                    </a>
                    <a class="app-sidebar__link" asp-area="" asp-controller="BulkOutMaterialEntry" asp-action="Index">
                        <span class="app-sidebar__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <path d="M5 4h9v2H5v3L1 5.5 5 2zM19 20h-9v-2h9v-3l4 3.5L19 22z" />
                            </svg>
                        </span>
                        <span class="app-sidebar__label">Out Material Entry</span>
                    </a>
                </div>

                <div class="app-sidebar__group">
                    <div class="app-sidebar__group-label">Reporting</div>
                    <a class="app-sidebar__link" asp-area="" asp-controller="GetDatewiseData" asp-action="Index">
                        <span class="app-sidebar__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <path d="M7 2v2H5a2 2 0 0 0-2 2v2h18V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2z" />
                                <path d="M21 10H3v8a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2z" />
                            </svg>
                        </span>
                        <span class="app-sidebar__label">Datewise Status</span>
                    </a>
                    <a class="app-sidebar__link" asp-area="" asp-controller="Invoice" asp-action="Index">
                        <span class="app-sidebar__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <path d="M6 2h9l5 5v15a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zM14 3.5V8h4.5"></path>
                                <path d="M8 12h8M8 16h8M8 20h5"></path>
                            </svg>
                        </span>
                        <span class="app-sidebar__label">Invoice Generation</span>
                    </a>
                </div>
            </nav>

            <button class="app-sidebar__toggle" type="button" data-sidebar-toggle aria-label="Toggle sidebar"></button>

            @if (User?.Identity?.IsAuthenticated == true)
            {
                var displayName = User.Identity.Name ?? "";
                var initials = string.Concat(displayName.Split(new[] { ' ', '.', '_' }, StringSplitOptions.RemoveEmptyEntries)
                    .Take(2).Select(p => char.ToUpperInvariant(p[0])));
                if (string.IsNullOrEmpty(initials) && displayName.Length > 0)
                {
                    initials = char.ToUpperInvariant(displayName[0]).ToString();
                }
                <div class="app-sidebar__footer">
                    <span class="app-sidebar__avatar" aria-hidden="true">@initials</span>
                    <div class="app-sidebar__identity">
                        <div class="app-sidebar__name">@displayName</div>
                        <div class="app-sidebar__signed-in">Signed in</div>
                    </div>
                    <button class="app-sidebar__signout" type="button" id="btnLogout" aria-label="Sign out" title="Sign out">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h5v-2H5V5h5V3z" />
                            <path d="M16 16l5-4-5-4v3H9v2h7v3z" />
                        </svg>
                    </button>
                </div>
            }
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div class="app-topbar__left">
                    <button class="app-topbar__sidebar-trigger" type="button" data-sidebar-toggle aria-label="Toggle sidebar">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="M4 6h16v2H4zM4 11h10v2H4zM4 16h16v2H4z" />
                        </svg>
                    </button>
                    @if (ViewData["Section"] != null)
                    {
                        <span class="app-topbar__section">@ViewData["Section"]</span>
                        <span class="app-topbar__crumb-sep" aria-hidden="true">›</span>
                        <span class="app-topbar__title">@ViewData["Title"]</span>
                    }
                    else
                    {
                        <span class="app-topbar__title">@ViewData["Title"]</span>
                        <span class="app-topbar__meta" id="appTopbarMeta">@ViewData["PageMeta"]</span>
                    }
                </div>
                <div class="app-topbar__right">
                    @await RenderSectionAsync("HeaderActions", required: false)
                </div>
            </header>

            <main class="app-content" role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/appjs/jr-controls.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
