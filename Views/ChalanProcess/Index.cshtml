@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Chalan Process";
    ViewData["Section"] = "Operations";
}

@section HeaderActions {
    <div class="jr-search">
        <svg viewBox="0 0 24 24" focusable="false"><path d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 5L20.49 19zm-6 0a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9z" /></svg>
        <input type="text" id="chalanGlobalSearch" placeholder="Search chalan no, component…" />
        <span class="jr-search__kbd">⌘K</span>
    </div>
    <button type="button" class="jr-btn jr-btn--accent" id="btnHeaderNewChalan">+ New incoming chalan</button>
}

<div class="jr-page-title">
    <div>
        <h1>Chalan Process</h1>
        <div class="jr-page-title__meta" id="chalanPageMeta">Loading…</div>
    </div>
    <button type="button" class="jr-btn jr-btn--ghost" id="btnExportCsv">Export CSV</button>
</div>

<section class="jr-metric-strip" id="idChalanEntry">
    <div class="jr-metric">
        <div class="jr-metric__label">Incoming material</div>
        <div class="jr-metric__value jr-tabular" id="kpiIncoming">—</div>
        <div class="jr-metric__qualifier">Nos</div>
    </div>
    <div class="jr-metric">
        <div class="jr-metric__label">Out material</div>
        <div class="jr-metric__value jr-tabular" id="kpiOut">—</div>
        <div class="jr-metric__qualifier" id="kpiOutPct"></div>
    </div>
    <div class="jr-metric">
        <div class="jr-metric__label">Pending material</div>
        <div class="jr-metric__value jr-tabular" id="kpiPending">—</div>
        <div class="jr-metric__track"><div class="jr-metric__track-fill jr-metric__track-fill--warning" id="kpiPendingTrack" style="width:0%"></div></div>
        <div class="jr-metric__qualifier" id="kpiPendingQualifier"></div>
    </div>
    <div class="jr-metric">
        <div class="jr-metric__label">Rejected material</div>
        <div class="jr-metric__value jr-tabular" id="kpiRejected">—</div>
        <div class="jr-metric__qualifier" id="kpiRejectedPct"></div>
    </div>
</section>

<section class="jr-card" id="idChalanNew" hidden>
    <div class="jr-card__header">
        <span class="jr-card__title">Chalan In Material Entry</span>
        <button type="button" class="jr-row-btn jr-row-btn--borderless" id="btnCancelNewChalan">Cancel</button>
    </div>
    <div class="jr-card__body" style="display:flex;flex-wrap:wrap;gap:14px;align-items:end;">
        <div class="jr-field">
            <label class="jr-field__label">Date<span class="jr-field__required">*</span></label>
            <div class="jr-daterange" data-jr-daterange>
                <input type="hidden" data-jr-role="start" id="idDatenew" />
                <button type="button" class="jr-daterange__trigger">
                    <svg viewBox="0 0 24 24"><path d="M7 2v2H5a2 2 0 0 0-2 2v2h18V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2z" /><path d="M21 10H3v8a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2z" /></svg>
                    <span class="jr-daterange__label jr-tabular"></span>
                </button>
                <div class="jr-daterange__panel" hidden></div>
            </div>
        </div>
        <div class="jr-field" style="min-width:260px;">
            <label class="jr-field__label" for="ddlComponentnew">Component description<span class="jr-field__required">*</span></label>
            <div class="jr-dropdown" data-jr-dropdown>
                <select id="ddlComponentnew" hidden>
                    <option value="0">Please Select</option>
                    <option value="JR_JLRDC">J LWD Rear Diff Case 10013476-030</option>
                    <option value="JR_JHS">J Hub Small 111.06.021.61.9</option>
                    <option value="JR_JCD">J Case Differential 40112573(Dost Diff Case AAM)</option>
                    <option value="JR_JPDC">J P Diff Case 112.04.001.61.9-PDNS3404145012</option>
                    <option value="JR_JWH">J Wheel Hub 708.06.0003.63.9</option>
                    <option value="JR_JDCEFH">J Diff Case Eld s/f M180 Flange Half 10019886</option>
                    <option value="JR_JDCFHRS">J Diff Case Flange Half Rgh Spilt - 2015985</option>
                    <option value="JR_JLRDC2">J Mcie-3.3L Front Hub 0503Gaa 0047</option>
                    <option value="JR_JDCSD103">J Diff Case S20Dc103</option>
                    <option value="JR_JDCSD104">J Diff Case S20Dc104</option>
                    <option value="JR_JDC32931">J Diff Case 32931</option>
                    <option value="JR_JDC10043998">J P-375 Rear Diff Case 10043997</option>
                    <option value="JR_JDCR252596A130E1">J Diff Cover R252596-A130E1(Sona)</option>
                    <option value="JR_JRCDP40233011">J Raw Case Diff P40233011(Phonix Intigral Diff Case)</option>
                </select>
                <button type="button" class="jr-dropdown__trigger" style="width:100%;min-width:260px;"><span class="jr-dropdown__label"></span><svg class="jr-dropdown__caret" viewBox="0 0 24 24"><path d="M7 10l5 5 5-5z" /></svg></button>
                <div class="jr-dropdown__panel" hidden>
                    <div class="jr-dropdown__filter">
                        <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 5L20.49 19zm-6 0a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9z" /></svg>
                        <input class="jr-dropdown__filter-input" type="text" placeholder="Filter components…" />
                    </div>
                    <div class="jr-dropdown__list"></div>
                    <div class="jr-dropdown__footer"><span>↑↓ to move · Enter to select</span><span>Esc to close</span></div>
                </div>
            </div>
        </div>
        <div class="jr-field">
            <label class="jr-field__label" for="idchalanNonew">Chalan no<span class="jr-field__required">*</span></label>
            <input type="text" class="jr-input" id="idchalanNonew" />
        </div>
        <div class="jr-field">
            <label class="jr-field__label" for="idQuantitynew">Quantity<span class="jr-field__required">*</span></label>
            <input type="text" class="jr-input" id="idQuantitynew" />
        </div>
        <button type="button" class="jr-btn jr-btn--accent" id="SaveChalanStatus">Save entry</button>
    </div>
</section>

<section class="jr-card" id="idChalanProcessGrid">
    <div class="jr-toolbar">
        <div class="jr-segmented" role="tablist">
            <button type="button" class="jr-segmented__btn is-active" data-tab="open">Open <span class="jr-segmented__count" id="tabOpenCount">—</span></button>
            <button type="button" class="jr-segmented__btn" data-tab="closed">Closed <span class="jr-segmented__count" id="tabClosedCount">—</span></button>
            <button type="button" class="jr-segmented__btn" data-tab="all">All</button>
        </div>

        <div class="jr-dropdown" data-jr-dropdown>
            <select id="componentSearch" hidden>
                <option value="">All components</option>
                <option value="J LWD Rear Diff Case 10013476-030">J LWD Rear Diff Case 10013476-030</option>
                <option value="J Hub Small 111.06.021.61.9">J Hub Small 111.06.021.61.9</option>
                <option value="J Case Differential 40112573(Dost Diff Case AAM)">J Case Differential 40112573(Dost Diff Case AAM)</option>
                <option value="J P Diff Case 112.04.001.61.9-PDNS3404145012">J P Diff Case 112.04.001.61.9-PDNS3404145012</option>
                <option value="J Wheel Hub 708.06.0003.63.9">J Wheel Hub 708.06.0003.63.9</option>
                <option value="J Diff Case Eld s/f M180 Flange Half 10019886">J Diff Case Eld s/f M180 Flange Half 10019886</option>
                <option value="J Diff Case Flange Half Rgh Spilt - 2015985">J Diff Case Flange Half Rgh Spilt - 2015985</option>
                <option value="J Mcie-3.3L Front Hub 0503Gaa 0047">J Mcie-3.3L Front Hub 0503Gaa 0047</option>
                <option value="J Diff Case S20Dc103">J Diff Case S20Dc103</option>
                <option value="J Diff Case S20Dc104">J Diff Case S20Dc104</option>
                <option value="J Diff Case 32931">J Diff Case 32931</option>
                <option value="J P-375 Rear Diff Case 10043997">J P-375 Rear Diff Case 10043997</option>
                <option value="J Diff Cover R252596-A130E1(Sona)">J Diff Cover R252596-A130E1(Sona)</option>
                <option value="J Raw Case Diff P40233011(Phonix Intigral Diff Case)">J Raw Case Diff P40233011(Phonix Intigral Diff Case)</option>
            </select>
            <button type="button" class="jr-dropdown__trigger"><span class="jr-dropdown__label"></span><svg class="jr-dropdown__caret" viewBox="0 0 24 24"><path d="M7 10l5 5 5-5z" /></svg></button>
            <div class="jr-dropdown__panel" hidden>
                <div class="jr-dropdown__filter">
                    <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 5L20.49 19zm-6 0a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9z" /></svg>
                    <input class="jr-dropdown__filter-input" type="text" placeholder="Filter components…" />
                </div>
                <div class="jr-dropdown__list"></div>
                <div class="jr-dropdown__footer"><span>↑↓ to move · Enter to select</span><span>Esc to close</span></div>
            </div>
        </div>

        <div class="jr-daterange" data-jr-daterange>
            <input type="hidden" id="chalanDateFrom" data-jr-role="start" />
            <input type="hidden" id="chalanDateTo" data-jr-role="end" />
            <button type="button" class="jr-daterange__trigger">
                <svg viewBox="0 0 24 24"><path d="M7 2v2H5a2 2 0 0 0-2 2v2h18V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2z" /><path d="M21 10H3v8a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2z" /></svg>
                <span class="jr-daterange__label jr-tabular"></span>
            </button>
            <div class="jr-daterange__panel" hidden></div>
        </div>

        <div class="jr-toolbar__spacer">
            <span class="jr-toolbar__count" id="chalanRowCount"></span>
        </div>
    </div>

    <div class="jr-table-wrap">
        <table class="jr-table" id="tblchalanProcess">
            <thead>
                <tr>
                    <th style="width:9%">Date</th>
                    <th style="width:24%">Component</th>
                    <th style="width:10%">Chalan no</th>
                    <th style="width:8%" class="jr-text-right">Qty in</th>
                    <th style="width:8%" class="jr-text-right">Out</th>
                    <th style="width:13%" class="jr-text-right">Pending</th>
                    <th style="width:16%">Status</th>
                    <th style="width:12%" class="jr-text-right">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <div class="jr-pagination">
        <span class="jr-pagination__summary" id="chalanPageSummary"></span>
        <div class="jr-pagination__controls">
            <button type="button" class="jr-btn jr-btn--ghost jr-btn--sm" id="chalanPagePrev">‹ Prev</button>
            <span class="jr-pagination__page" id="chalanPageIndicator"></span>
            <button type="button" class="jr-btn jr-btn--ghost jr-btn--sm" id="chalanPageNext">Next ›</button>
        </div>
    </div>
</section>

<input type="hidden" id="HdnProcessHdeSeq" name="hiddenFieldName">

@section Scripts {
    <script src="~/appjs/ChalanProcess.js" asp-append-version="true"></script>
}
