@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Datewise Status";
    ViewData["Section"] = "Reporting";
}

<div class="jr-page-title">
    <div>
        <h1>Datewise Status</h1>
        <div class="jr-page-title__meta" id="datewisePageMeta">Loading…</div>
    </div>
    <div style="display:flex; gap:10px; align-items:center;">
        <div class="jr-segmented" role="tablist">
            <button type="button" class="jr-segmented__btn is-active" data-tab="inward">Incoming</button>
            <button type="button" class="jr-segmented__btn" data-tab="outward">Out material</button>
            <button type="button" class="jr-segmented__btn" data-tab="pending">Rejected</button>
        </div>

        <div class="jr-daterange" data-jr-daterange>
            <input type="hidden" id="txtFromDate" data-jr-role="start" />
            <input type="hidden" id="txtToDate" data-jr-role="end" />
            <button type="button" class="jr-daterange__trigger">
                <svg viewBox="0 0 24 24"><path d="M7 2v2H5a2 2 0 0 0-2 2v2h18V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2z" /><path d="M21 10H3v8a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2z" /></svg>
                <span class="jr-daterange__label jr-tabular"></span>
            </button>
            <div class="jr-daterange__panel" hidden></div>
        </div>

        <button type="button" class="jr-btn jr-btn--accent" id="btnRunReport">Run report</button>
    </div>
</div>

<section class="jr-metric-strip">
    <div class="jr-metric">
        <div class="jr-metric__label">In, this period</div>
        <div class="jr-metric__value jr-tabular" id="statInPeriod">—</div>
    </div>
    <div class="jr-metric">
        <div class="jr-metric__label">Out, this period</div>
        <div class="jr-metric__value jr-tabular" id="statOutPeriod">—</div>
    </div>
    <div class="jr-metric">
        <div class="jr-metric__label">Net pending, this period</div>
        <div class="jr-metric__value jr-tabular" id="statNetPending">—</div>
    </div>
</section>

<section class="jr-card">
    <div class="jr-toolbar">
        <div class="jr-toolbar__spacer">
            <button type="button" class="jr-btn jr-btn--ghost" id="btnDownloadPendingPdf">Download PDF</button>
            <button type="button" class="jr-btn jr-btn--ghost" id="btnExportDatewiseCsv">Export CSV</button>
        </div>
    </div>

    <div class="jr-table-wrap">
        <table class="jr-table" id="tblDatewiseResults">
            <thead>
                <tr>
                    <th style="width:6%">Sr</th>
                    <th style="width:39%">Material code &amp; description</th>
                    <th style="width:12%" class="jr-text-right" id="datewiseQtyHeader1">Qty</th>
                    <th style="width:12%" class="jr-text-right" id="datewiseQtyHeader2"></th>
                    <th style="width:31%">Share of period</th>
                </tr>
            </thead>
            <tbody></tbody>
            <tfoot id="datewiseTotalsRow" hidden>
                <tr>
                    <td colspan="2" class="jr-text-right"><strong id="datewiseTotalsLabel">Total</strong></td>
                    <td class="jr-text-right jr-tabular"><strong id="datewiseTotal1"></strong></td>
                    <td class="jr-text-right jr-tabular"><strong id="datewiseTotal2"></strong></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf-autotable@3.8.2/dist/jspdf.plugin.autotable.min.js"></script>
    <script src="~/appjs/DatewiseData.js" asp-append-version="true"></script>
}
